{
  "name": "duel-spirits",
  "private": true,
  "version": "0.1.11",
  "description": "친구와 즐기는 1대1 전략 카드 게임",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksa-mewmew/duel-spirits.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "server:dev": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "package:desktop": "npm run build && electron-forge package",
    "make:desktop": "npm run build && electron-forge make",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "sim:test": "node scripts/run-simulator.mjs self-test",
    "sim:meta": "node scripts/run-simulator.mjs cli",
    "sim:samples": "node scripts/run-simulator.mjs sample-decks",
    "check": "npm run test:run && npm run build",
    "server:deploy": "wrangler deploy",
    "server:tail": "wrangler tail",
    "server:whoami": "wrangler whoami"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260625.1",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "concurrently": "^9.2.0",
    "electron": "^37.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4",
    "wrangler": "4.105.0"
  },
  "dependencies": {
    "partyserver": "0.5.8",
    "partysocket": "1.3.0"
  }
}
